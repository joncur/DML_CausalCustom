[
  {
    "file": "eq-001.svg",
    "latex": "\\widetilde Y_i=Y_i-\\widehat m^{(-k(i))}(X_i,W_i),\\qquad\nR_i=\\phi(T_i)-\\widehat e^{(-k(i))}(X_i,W_i).",
    "display": true,
    "document": "README.md"
  },
  {
